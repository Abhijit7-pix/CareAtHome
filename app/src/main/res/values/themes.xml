<resources>

    <style name="Base.Theme.CareAtHome" parent="Theme.Material3.DayNight.NoActionBar">

    </style>

    <style name="Theme.CareAtHome" parent="Base.Theme.CareAtHome" />

    <style name="Theme.YourApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="Theme.CareAtHome.Fullscreen" parent="Theme.CareAtHome">
        <item name="android:actionBarStyle">@style/Widget.Theme.CareAtHome.ActionBar.Fullscreen
        </item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
    </style>

    <style name="ThemeOverlay.CareAtHome.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_600</item>
        <item name="fullscreenTextColor">@color/light_blue_A200</item>
    </style>

</resources>
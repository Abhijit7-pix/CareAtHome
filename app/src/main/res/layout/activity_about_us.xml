<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F5DC">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="20dp"
        android:background="@drawable/logo"/>

    <TextView
        android:id="@+id/appname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="40dp"
        android:layout_toRightOf="@id/logo"
        android:text="CareAtHome"
        android:textColor="@color/light_blue_600"
        android:textSize="27dp" />


    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/appname"
        android:layout_marginLeft="70dp"
        android:layout_marginTop="10dp"
        android:layout_toRightOf="@+id/logo"
        android:text="-By Brogrammers"
        android:textSize="20dp"
        android:textColor="#808080"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/logo"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AboutUs:"
                android:textSize="30dp"
                android:layout_marginTop="10dp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CareAtHome is your go-to platform for essential home services, bringing skilled professionals like electricians, plumbers, carpenters, maids, and caretakers directly to your door. We offer a seamless experience where you can easily book, manage, and track service appointments—all in one app.

Our trusted and vetted professionals ensure top-quality service, prioritizing your safety and satisfaction. From maintenance and repairs to beauty and wellness, CareAtHome is your one-stop solution for all your household needs."
                android:textSize="20dp"
                android:textColor="#2F4F4F"
                android:layout_marginTop="15dp"
                android:textAlignment="textStart"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Us:"
                android:layout_marginTop="30dp"
                android:textSize="30dp"
                android:textStyle="italic"/>

            <TextView
                android:id="@+id/phone_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Call us: +91 9325907915"
                android:textSize="20dp"
                android:textStyle="italic"
                android:layout_marginTop="20dp"/>

            <TextView
                android:id="@+id/email_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email us: varad266@gmail.com"
                android:layout_marginTop="15dp"
                android:textSize="20dp"/>

            <TextView
                android:id="@+id/physical_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visit us: Barshi, dist: Solapur, Maharashtra"
                android:layout_marginTop="15dp"
                android:textSize="20dp"/>
        </LinearLayout>





    </ScrollView>



</RelativeLayout>